# ── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_NAME="Hizmet Kasa"
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/hizmet_kasa

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-this-super-secret-key-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-this-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=300

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── S3 / MinIO ───────────────────────────────────────────────
S3_BUCKET=hizmet-kasa
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_ENDPOINT=http://localhost:9000
